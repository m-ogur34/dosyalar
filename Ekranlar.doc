<h3 id=3D"Ekranlar-2.Filtreler">2. Filtreler</h3>
<p><strong>Genel kurallar</strong></p>
<ul>
 <li data-uuid=3D"40815303-e8c9-4eb8-8e30-759a47d3dd37">Filtreler se=C3=A7i=
ldi=C4=9Fi anda uygulan=C4=B1r; ayr=C4=B1ca bir =E2=80=9CUygula=E2=80=9D bu=
tonuna bas=C4=B1lmas=C4=B1 beklenmez.</li>
 <li data-uuid=3D"2627279e-1874-4b88-9503-d27ead48db78">Birden fazla filtre=
 se=C3=A7ilirse hepsi birlikte uygulan=C4=B1r. =C3=96rne=C4=9Fin =C4=B0l =
=3D Rize ve A=C3=A7=C4=B1k/Kapal=C4=B1 =3D Kapal=C4=B1 se=C3=A7ilince yaln=
=C4=B1z Rize=E2=80=99deki kapal=C4=B1 belediyeler gelir.</li>
 <li data-uuid=3D"e2ad9a10-411b-46a4-813a-811966149f63">Filtre de=C4=9Fi=C5=
=9Fince liste ilk sayfaya d=C3=B6ner; kay=C4=B1t say=C4=B1s=C4=B1 ve sayfal=
ama yeniden hesaplan=C4=B1r.</li>
 <li data-uuid=3D"16630cc1-7825-4944-89f2-4c491d117888">Ekran ilk a=C3=A7=
=C4=B1ld=C4=B1=C4=9F=C4=B1nda b=C3=BCt=C3=BCn filtreler bo=C5=9Ftur (Hepsi)=
.</li>
</ul>
<p><strong>Filtreler</strong></p>
<ul>
 <li data-uuid=3D"9c194f55-f6fc-4aa6-9c8a-2e19bfa3744e"><strong>Belediye =
=C4=B0l:</strong> Se=C3=A7enekler ekrandaki kay=C4=B1tlar=C4=B1n Belediye =
=C4=B0l kolonundan beslenir ve T=C3=BCrk=C3=A7e alfabeye g=C3=B6re s=C4=B1r=
alan=C4=B1r.</li>
 <li data-uuid=3D"22cdfe36-5d69-4b74-8af8-61b435cf6fb8"><strong>Belediye =
=C4=B0l=C3=A7e:</strong> Se=C3=A7enekler Belediye =C4=B0l=C3=A7e kolonundan=
 beslenir.
  <ul>
   <li>=C4=B0l se=C3=A7iliyse yaln=C4=B1z o ilin il=C3=A7eleri listelenir.<=
/li>
   <li>=C4=B0l se=C3=A7ilmeden ayn=C4=B1 adl=C4=B1 bir il=C3=A7e se=C3=A7il=
irse (=C3=B6r. Bayat: Afyonkarahisar ve =C3=87orum) iki ilin kay=C4=B1tlar=
=C4=B1 birlikte gelir.</li>
  </ul></li>
 <li data-uuid=3D"d36e0961-b0ef-4a2e-a2b7-918fc419ec61"><strong>A=C3=A7=C4=
=B1k / Kapal=C4=B1:</strong> Hepsi / A=C3=A7=C4=B1k / Kapal=C4=B1 se=C3=A7e=
neklerini i=C3=A7eren bir dropdown=E2=80=99d=C4=B1r.</li>
 <li data-uuid=3D"3c8acc8d-6e19-4508-a3ee-c9b3c1033c09"><strong>Web G=C3=B6=
nderimi:</strong> Web G=C3=B6nderimi kolonundan beslenir. Hepsi / Evet / Ha=
y=C4=B1r se=C3=A7eneklerini i=C3=A7erir.</li>
 <li data-uuid=3D"b04a4b19-c875-4e40-a1d7-66d7c8a27a2b"><strong>IBAN Dolu /=
 Bo=C5=9F:</strong> Hepsi / Dolu / Bo=C5=9F se=C3=A7eneklerini i=C3=A7erir.
  <ul>
   <li>Dolu se=C3=A7ildi=C4=9Finde yaln=C4=B1z IBAN=E2=80=99=C4=B1 girilmi=
=C5=9F kay=C4=B1tlar listelenir.</li>
   <li>Bo=C5=9F se=C3=A7ildi=C4=9Finde yaln=C4=B1z IBAN=E2=80=99=C4=B1 giri=
lmemi=C5=9F kay=C4=B1tlar listelenir. Bunlar listede k=C4=B1rm=C4=B1z=C4=B1=
 =E2=80=9CEksik=E2=80=9D olarak g=C3=B6r=C3=BCnenlerdir.</li>
  </ul></li>
</ul>
<p><strong>Temizle butonu:</strong> Se=C3=A7ili b=C3=BCt=C3=BCn filtreleri =
kald=C4=B1r=C4=B1r; liste filtresiz olarak ilk sayfadan gelir.</p>
<h3 id=3D"Ekranlar-3.ExcelY=C3=BCklePop-up=E2=80=99=C4=B1">3. Excel Y=C3=BC=
kle Pop-up=E2=80=99=C4=B1</h3>
<p><strong>A=C3=A7=C4=B1l=C4=B1=C5=9F</strong></p>
<ul>
 <li data-uuid=3D"db5fadfd-d3a8-4a1f-b1b2-a82f845539fd">Excel Y=C3=BCkle bu=
tonuna t=C4=B1kland=C4=B1=C4=9F=C4=B1nda Excel Y=C3=BCkle pop-up=E2=80=99=
=C4=B1 a=C3=A7=C4=B1l=C4=B1r.</li>
 <li data-uuid=3D"3f07a64b-f7d6-4b34-b859-766a10760433">Alanlar: D=C3=B6nem=
, TBB listesi (Excel) ve Dosya Se=C3=A7 butonu, =C5=9Eablonu indir.</li>
 <li data-uuid=3D"a22b7290-3f4c-4b0d-a423-68dd8b5e590f">Butonlar: Vazge=C3=
=A7, Y=C3=BCkle.</li>
</ul>
<p><strong>D=C3=B6nem</strong></p>
<ul>
 <li data-uuid=3D"402c609d-472a-473d-98c5-2a7566db59bd">Dropdown=E2=80=99d=
=C4=B1r; d=C3=B6nemler ay/y=C4=B1l format=C4=B1ndad=C4=B1r (=C3=B6r. 09/202=
6).</li>
 <li data-uuid=3D"042bbd45-685c-4370-a569-09625258f4a5">Se=C3=A7ilebilecek =
en g=C3=BCncel d=C3=B6nem, i=C3=A7inde bulunulan aydan bir =C3=B6nceki ayd=
=C4=B1r. =C3=96rne=C4=9Fin Ekim ay=C4=B1ndaysak en son 09/2026 se=C3=A7ileb=
ilir.</li>
 <li data-uuid=3D"667a0a92-57df-4363-b187-11aac4588121">=C4=B0leri tarihli =
d=C3=B6nemler listede yer almaz; Eyl=C3=BCl ay=C4=B1nda 12/2026 d=C3=B6nemi=
ne Excel y=C3=BCklenemez.</li>
 <li data-uuid=3D"a58e61bd-58bc-4d40-8ec4-4b74a81c4882">Varsay=C4=B1lan ola=
rak bir =C3=B6nceki ay se=C3=A7ili gelir.</li>
</ul>
<p><strong>Dosya se=C3=A7imi</strong></p>
<ul>
 <li data-uuid=3D"89316d63-6295-4c7f-87b7-693caa4f757b">Dosya Se=C3=A7 buto=
nuyla kullan=C4=B1c=C4=B1n=C4=B1n bilgisayar=C4=B1ndan dosya se=C3=A7ilir. =
Yaln=C4=B1z .xlsx dosyas=C4=B1 kabul edilir.</li>
 <li data-uuid=3D"2eb9a752-b20c-4799-a88c-e66ee1ff19e1">Se=C3=A7ilen dosyan=
=C4=B1n ad=C4=B1 TBB listesi (Excel) alan=C4=B1nda g=C3=B6r=C3=BCn=C3=BCr.<=
/li>
 <li data-uuid=3D"87886f6f-905c-4a9c-aa34-317c7ee9b55d">Dosya yaln=C4=B1z Y=
=C3=BCkle butonuna bas=C4=B1ld=C4=B1=C4=9F=C4=B1nda i=C5=9Flenir.</li>
</ul>
<p><strong>=C5=9Eablonu indir</strong></p>
<ul>
 <li data-uuid=3D"d3252735-f1bd-46c3-8c5e-18a355967853">=C4=B0=C5=9F birimi=
yle belirlenecek =C5=9Fablon (=C4=B0l, =C4=B0l=C3=A7e, Belediye kolonlar=C4=
=B1) bu ba=C4=9Flant=C4=B1dan indirilir.</li>
 <li data-uuid=3D"53bef470-b001-4db5-b5d2-d410cab8a282">Y=C3=BCklenen dosya=
 =C5=9Fablona uymazsa (kolon eksikse ya da hi=C3=A7 sat=C4=B1r yoksa) hata =
mesaj=C4=B1 g=C3=B6sterilir ve kar=C5=9F=C4=B1la=C5=9Ft=C4=B1rma yap=C4=B1l=
maz.</li>
</ul>
<p><strong>Vazge=C3=A7:</strong> Pop-up kapan=C4=B1r; dosya y=C3=BCklenmez,=
 hi=C3=A7bir kay=C4=B1t de=C4=9Fi=C5=9Fmez.</p>
<p><strong>Y=C3=BCkle</strong></p>
<ul>
 <li data-uuid=3D"d9cbabf4-60b7-48ab-9450-c5c392ebb925">D=C3=B6nem ve dosya=
 se=C3=A7ilmeden Y=C3=BCkle butonu aktif olmaz.</li>
 <li data-uuid=3D"30de2597-e422-4675-9d9e-505851b960c8">Y=C3=BCkle=E2=80=99=
ye bas=C4=B1l=C4=B1nca dosya ekrandaki kay=C4=B1tlarla kar=C5=9F=C4=B1la=C5=
=9Ft=C4=B1r=C4=B1l=C4=B1r ve sonu=C3=A7 =C3=B6nizleme penceresinde g=C3=B6s=
terilir. Kullan=C4=B1c=C4=B1 onaylamadan hi=C3=A7bir kay=C4=B1t de=C4=9Fi=
=C5=9Fmez.</li>
 <li data-uuid=3D"24616189-244e-4c85-b12e-16aae6637fa7">=C3=96nizleme pence=
resi =E2=80=9CEmin misiniz?=E2=80=9D onay=C4=B1n=C4=B1n yerini tutar; ayr=
=C4=B1 bir onay pop-up=E2=80=99=C4=B1na gerek kalmaz.</li>
</ul>
<p><strong>Kar=C5=9F=C4=B1la=C5=9Ft=C4=B1rma kurallar=C4=B1</strong></p>
<ul>
 <li data-uuid=3D"1b67b25a-eb9f-4191-89da-5805f6e5ec18"><strong>E=C5=9Fle=
=C5=9Ftirme:</strong>
  <ul>
   <li>=C4=B0l + il=C3=A7e + belediye ad=C4=B1 ile yap=C4=B1l=C4=B1r.</li>
   <li>B=C3=BCy=C3=BCk/k=C3=BC=C3=A7=C3=BCk harf, =E2=80=9CBelediyesi=E2=80=
=9D eki ve fazla bo=C5=9Fluklar dikkate al=C4=B1nmaz.</li>
   <li>Harf d=C3=B6n=C3=BC=C5=9F=C3=BCm=C3=BC T=C3=BCrk=C3=A7e kurallara g=
=C3=B6re yap=C4=B1l=C4=B1r (i/=C4=B0, =C4=B1/I).</li>
  </ul></li>
 <li data-uuid=3D"0e718bf7-e6f4-48d6-ac57-2d73296b2990"><strong>Kar=C5=9F=
=C4=B1la=C5=9Ft=C4=B1rma d=C4=B1=C5=9F=C4=B1:</strong> =C4=B0l=C3=A7esi =E2=
=80=9CMerkez=E2=80=9D olan belediyeler ve b=C3=BCy=C3=BCk=C5=9Fehir belediy=
eleri kar=C5=9F=C4=B1la=C5=9Ft=C4=B1r=C4=B1lmaz.</li>
 <li data-uuid=3D"692bf7f7-01c2-402f-b173-855827e5197c"><strong>Ekranda a=
=C3=A7=C4=B1k olup TBB Excel=E2=80=99inde olmayan belediye:</strong> Kapanm=
=C4=B1=C5=9F demektir; =C3=B6nizlemede =E2=80=9CKapat=C4=B1lacak belediyele=
r=E2=80=9D listesine gelir. Onaylan=C4=B1nca:
  <ul>
   <li>A=C3=A7=C4=B1k/Kapal=C4=B1 alan=C4=B1 Kapal=C4=B1 olur.</li>
   <li>=C3=96demesi merkez belediyeye aktar=C4=B1l=C4=B1r.</li>
   <li>Son G=C3=BCncelleme alan=C4=B1na tarih ve =E2=80=9CTBB Excel=E2=80=
=9D yaz=C4=B1l=C4=B1r.</li>
  </ul></li>
 <li data-uuid=3D"486c8c62-ae27-4067-a385-956f7ccb8253"><strong>TBB Excel=
=E2=80=99inde olup ekranda olmayan belediye:</strong> =C3=96nizlemede =E2=
=80=9CEklenecek belediyeler=E2=80=9D listesine gelir. Onaylan=C4=B1nca yeni=
 bir sat=C4=B1r olu=C5=9Fturulur:
  <ul>
   <li>=C4=B0l, il=C3=A7e ve belediye ad=C4=B1 Excel=E2=80=99den al=C4=B1n=
=C4=B1r.</li>
   <li>=C4=B0l ve il=C3=A7e kodu, ayn=C4=B1 il ve il=C3=A7edeki mevcut kay=
=C4=B1tlarda varsa al=C4=B1n=C4=B1r.</li>
   <li>A=C3=A7=C4=B1k/Kapal=C4=B1 =3D A=C3=A7=C4=B1k olur; =C3=96denecek Be=
lediye kurala g=C3=B6re belirlenir.</li>
   <li>IBAN ve KEP bo=C5=9F gelir; sat=C4=B1r k=C4=B1rm=C4=B1z=C4=B1 (=E2=
=80=9CEksik=E2=80=9D) g=C3=B6r=C3=BCn=C3=BCr.</li>
   <li>Bu belediyeye =C3=B6deme =C3=A7=C4=B1karsa dashboard, kullan=C4=B1c=
=C4=B1y=C4=B1 Belediye Tan=C4=B1m=C4=B1 ekran=C4=B1ndaki eksik bilgileri ta=
mamlamaya y=C3=B6nlendirir.</li>
  </ul></li>
 <li data-uuid=3D"17fc87b4-28b8-4720-89c6-dfd2b6fb905a"><strong>Her iki lis=
tede de olan belediye:</strong> De=C4=9Fi=C5=9Fmez.</li>
 <li data-uuid=3D"369e67ab-ef98-492f-a119-5c5e8b375bf7"><strong>Onaydan son=
ra (y=C3=BCkle butonunun ard=C4=B1ndan):</strong> Sayfa =C3=BCst=C3=BCndeki=
 =E2=80=9CSon Excel y=C3=BCklemesi: AA/YYYY=E2=80=9D bilgisi g=C3=BCncellen=
ir.</li>
</ul>
<h3 id=3D"Ekranlar-4.=C4=B0=C5=9FlemSe=C3=A7iniz=E2=80=93D=C3=BCzenle">4. =
=C4=B0=C5=9Flem Se=C3=A7iniz =E2=80=93 D=C3=BCzenle</h3>
<ul>
 <li data-uuid=3D"cd7e955f-124f-4a05-aa67-83c845ba1eed">Her sat=C4=B1rdaki =
=C4=B0=C5=9Flem Se=C3=A7iniz alan=C4=B1na t=C4=B1kland=C4=B1=C4=9F=C4=B1nda=
 bir dropdown a=C3=A7=C4=B1l=C4=B1r; tek se=C3=A7enek D=C3=BCzenle=E2=80=99=
dir.</li>
 <li data-uuid=3D"cace7e8a-96a4-4a85-a2d7-92bf655124af">D=C3=BCzenle=E2=80=
=99ye t=C4=B1kland=C4=B1=C4=9F=C4=B1nda sat=C4=B1r=C4=B1n bilgileriyle D=C3=
=BCzenle pop-up=E2=80=99=C4=B1 a=C3=A7=C4=B1l=C4=B1r. Ba=C5=9Fl=C4=B1=C4=9F=
=C4=B1n alt=C4=B1nda belediye ad=C4=B1 ve il yazar; alanlar mevcut de=C4=9F=
erlerle dolu gelir.</li>
 <li data-uuid=3D"67b09a80-e30d-403d-97ca-88fcb339532e"><strong>D=C3=BCzenl=
enebilir alanlar:</strong> Web G=C3=B6nderimi, IBAN, KEP Adresi. (Di=C4=9Fe=
r alanlar=C4=B1n d=C3=BCzenlenebilirli=C4=9Fi hakk=C4=B1nda tekrar g=C3=B6r=
=C3=BC=C5=9F=C3=BClecek)</li>
 <li data-uuid=3D"7e8b0d2a-e271-4a4a-bddf-47054689ff17"><strong>Pop-up=E2=
=80=99ta yer almayan, de=C4=9Fi=C5=9Ftirilemeyen alanlar:</strong> il/il=C3=
=A7e kodu, il, il=C3=A7e, belediye ad=C4=B1, A=C3=A7=C4=B1k/Kapal=C4=B1 ve =
=C3=96denecek Belediye. <em>(Tart=C4=B1=C5=9F=C4=B1lacak: Excel ile eklenen=
 yeni sat=C4=B1rlarda baz=C4=B1 alanlar=C4=B1n elle girilmesine izin verils=
in mi?)</em></li>
 <li data-uuid=3D"f231465f-1434-402d-88e9-2bfd5407e290"><strong>Se=C3=A7ene=
kli alanlar:</strong> Text olarak girilmez, dropdown=E2=80=99dan se=C3=A7il=
ir (=C3=B6r. Web G=C3=B6nderimi: Evet / Hay=C4=B1r).</li>
 <li data-uuid=3D"11d0acdb-3cc0-4313-9c08-97e216dbec85"><strong>IBAN kontro=
lleri:</strong>
  <ul>
   <li>Bo=C5=9Fluklar dikkate al=C4=B1nmaz, harfler b=C3=BCy=C3=BCk harfe =
=C3=A7evrilir.</li>
   <li>TR ile ba=C5=9Flamal=C4=B1d=C4=B1r.</li>
   <li>26 karakter olmal=C4=B1d=C4=B1r.</li>
   <li>TR=E2=80=99den sonra yaln=C4=B1z rakam i=C3=A7ermelidir.</li>
   <li>Hata mesaj=C4=B1 alan=C4=B1n alt=C4=B1nda k=C4=B1rm=C4=B1z=C4=B1 g=
=C3=B6sterilir; hata varken Kaydet butonu pasiftir.</li>
  </ul></li>
 <li data-uuid=3D"3846552c-dfad-4a7c-ac27-985ff1fc7bc9"><strong>Kaydet:</st=
rong> De=C4=9Fi=C5=9Fiklik kaydedilir, pop-up kapan=C4=B1r ve liste g=C3=BC=
ncellenir. Son G=C3=BCncelleme alan=C4=B1na tarih ve kullan=C4=B1c=C4=B1 ya=
z=C4=B1l=C4=B1r; de=C4=9Fi=C5=9Fiklik log=E2=80=99a kaydedilir.</li>
 <li data-uuid=3D"540f6cf5-2a66-4c43-8f14-e2d0af050a85"><strong>Vazge=C3=A7=
 / X:</strong> Pop-up kapan=C4=B1r, de=C4=9Fi=C5=9Fiklik kaydedilmez.</li>
</ul>
