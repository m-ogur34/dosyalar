<h3 style=3D"margin-left: 40.0px;" id=3D"Ekranlar-6.Tablo">6. Tablo</h3>
<p style=3D"margin-left: 40.0px;"><strong>Kolonlar</strong></p>
<ul>
 <li style=3D"list-style-type: none;" data-uuid=3D"686ed31f-4a61-4c68-92c7-=
f83f102c7a28">
  <ul>
   <li data-uuid=3D"64a358af-a02b-400e-9a7c-e2526fe0dc57">Kolon s=C4=B1ras=
=C4=B1: se=C3=A7im kutusu, =C3=96denecek Belediye, =C3=9Cretim Bina, =C3=9C=
retim Muhteviyat, =C4=B0ptal Bina, =C4=B0ptal Muhteviyat, =C3=96denecek Tut=
ar, =C3=96deme Durumu, Red Mesaj=C4=B1, KEP Durumu, SBM Durumu.</li>
   <li data-uuid=3D"5a11b256-bfc1-4c8e-aff6-504c875c275c"><strong>=C3=96den=
ecek Belediye:</strong> =C3=96demenin yap=C4=B1laca=C4=9F=C4=B1 belediyedir=
. Her =C3=B6denecek belediye tek sat=C4=B1rd=C4=B1r ve ona ba=C4=9Fl=C4=B1 =
belediyelerin tutarlar=C4=B1 bu sat=C4=B1rda toplan=C4=B1r:
    <ul>
     <li data-uuid=3D"1e616b5d-30b2-4477-8d63-4b5073b13971">B=C3=BCy=C3=BCk=
=C5=9Fehir olan ilde b=C3=BCt=C3=BCn tutarlar [il] B=C3=BCy=C3=BCk=C5=9Fehi=
r Belediyesi sat=C4=B1r=C4=B1nda toplan=C4=B1r.</li>
     <li data-uuid=3D"2c62d91e-1332-4f84-aa81-a1256a6a539a">B=C3=BCy=C3=BCk=
=C5=9Fehir olmayan ilde her il=C3=A7e belediyesi kendi sat=C4=B1r=C4=B1ndad=
=C4=B1r.</li>
     <li data-uuid=3D"b5fb356b-bc4b-48f4-a1e2-c15e12c7bba4">Merkez il=C3=A7=
enin tutar=C4=B1 il belediyesinin sat=C4=B1r=C4=B1na gider.</li>
     <li data-uuid=3D"a4436020-654a-4f3e-a583-6a9486285134">Kapal=C4=B1 bel=
ediyenin tutar=C4=B1 merkez belediyenin sat=C4=B1r=C4=B1na eklenir.</li>
     <li data-uuid=3D"647d2f5f-37c4-4acf-a025-4be858c5cd67">E=C5=9Fle=C5=9F=
tirme il + il=C3=A7e + belediye ad=C4=B1na g=C3=B6re yap=C4=B1l=C4=B1r. Bu =
y=C3=BCzden ayn=C4=B1 adl=C4=B1 belediyeler (Afyonkarahisar / Bayat ve =C3=
=87orum / Bayat) ayr=C4=B1 sat=C4=B1rlard=C4=B1r.</li>
    </ul></li>
