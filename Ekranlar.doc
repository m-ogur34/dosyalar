mal=C4=B1d=C4=B1r.</li>
   <li data-uuid=3D"240a0c57-2a71-4895-afbe-5b2d4ef3d52d">26 karakter olmal=
=C4=B1d=C4=B1r.</li>
   <li data-uuid=3D"be72ba2c-0a51-4c00-b374-f1602d5677c5">TR=E2=80=99den so=
nra yaln=C4=B1z rakam i=C3=A7ermelidir.</li>
   <li data-uuid=3D"12c93741-69bc-47f3-a09b-2902b61a3741">Hata mesaj=C4=B1 =
alan=C4=B1n alt=C4=B1nda k=C4=B1rm=C4=B1z=C4=B1 g=C3=B6sterilir; hata varke=
n Kaydet butonu pasiftir.</li>
