   <li data-uuid=3D"5f7efff9-1f49-4e7d-a437-54fca3209844">=C4=B0l + il=C3=
=A7e + belediye ad=C4=B1 ile yap=C4=B1l=C4=B1r.</li>
   <li data-uuid=3D"503f20f2-3ca9-44aa-a791-b21826377e6d">B=C3=BCy=C3=BCk/k=
=C3=BC=C3=A7=C3=BCk harf, =E2=80=9CBelediyesi=E2=80=9D eki ve fazla bo=C5=
=9Fluklar dikkate al=C4=B1nmaz.</li>
   <li data-uuid=3D"585445d6-427a-43c5-b674-b8a70d54d512">Harf d=C3=B6n=C3=
=BC=C5=9F=C3=BCm=C3=BC T=C3=BCrk=C3=A7e kurallara g=C3=B6re yap=C4=B1l=C4=
=B1r (i/=C4=B0, =C4=B1/I).</li>
  </ul></li>
 <li data-uuid=3D"0e718bf7-e6f4-48d6-ac57-2d73296b2990"><strong>Kar=C5=9F=
=C4=B1la=C5=9Ft=C4=B1rma d=C4=B1=C5=9F=C4=B1:</strong> =C4=B0l=C3=A7esi =E2=
=80=9CMerkez=E2=80=9D olan belediyeler ve b=C3=BCy=C3=BCk=C5=9Fehir belediy=
eleri kar=C5=9F=C4=B1la=C5=9Ft=C4=B1r=C4=B1lmaz.</li>
 <li data-uuid=3D"692bf7f7-01c2-402f-b173-855827e5197c"><strong>Ekranda a=
=C3=A7=C4=B1k olup TBB Excel=E2=80=99inde olmayan belediye:</strong> Kapanm=
=C4=B1=C5=9F demektir; =C3=B6nizlemede =E2=80=9CKapat=C4=B1lacak belediyele=
r=E2=80=9D listesine gelir. Onaylan=C4=B1nca:
  <ul>
   <li data-uuid=3D"442cd018-6c5a-4815-81a2-1810e2444ca3">A=C3=A7=C4=B1k/Ka=
pal=C4=B1 alan=C4=B1 Kapal=C4=B1 olur.</li>
   <li data-uuid=3D"2a969e8e-2351-4f69-8133-9495f622b4c7">=C3=96demesi merk=
ez belediyeye aktar=C4=B1l=C4=B1r.</li>
   <li data-uuid=3D"4286e0a2-d098-4612-afe8-7e775e073e81">Son G=C3=BCncelle=
me alan=C4=B1na tarih ve =E2=80=9CTBB Excel=E2=80=9D yaz=C4=B1l=C4=B1r.</li=
